import math

def mostrar_menu():
    print("\n--- Calculadora Pro ---")
    print("1. Sumar")
    print("2. Multiplicar")
    print("3. Potencia (Elevar un número)")
    print("4. Raíz Cuadrada")
    print("5. Salir")

def calculadora():
    while True:
        mostrar_menu()
        opcion = input("\nElige una opción (1-5): ")

        if opcion == '5':
            print("¡Hasta luego!")
            break

        if opcion in ['1', '2', '3', '4']:
            try:
                # La raíz cuadrada solo requiere un número
                if opcion == '4':
                    num = float(input("Ingresa el número para calcular su raíz: "))
                    if num < 0:
                        print("Error: No se puede calcular la raíz de un número negativo.")
                    else:
                        resultado = math.sqrt(num)
                        print(f"Resultado: La raíz cuadrada de {num} es {resultado}")
                
                # Las demás opciones requieren dos números
                else:
                    num1 = float(input("Ingresa el primer número: "))
                    num2 = float(input("Ingresa el segundo número: "))
                    
                    if opcion == '1':
                        resultado = num1 + num2
                        print(f"Resultado: {num1} + {num2} = {resultado}")
                    
                    elif opcion == '2':
                        resultado = num1 * num2
                        print(f"Resultado: {num1} * {num2} = {resultado}")
                    
                    elif opcion == '3':
                        resultado = pow(num1, num2)
                        print(f"Resultado: {num1} elevado a {num2} es {resultado}")
            
            except ValueError:
                print("Error: Por favor, ingresa solo números válidos.")
        else:
            print("Opción no válida, intenta de nuevo.")

if __name__ == "__main__":
    calculadora()